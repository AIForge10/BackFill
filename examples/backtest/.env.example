# Copy this file to .env in the same folder and fill in your credentials.
# .env is gitignored: never commit it. Send keys to teammates privately.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_API_ENDPOINT=api.sandbox.webull.com
WEBULL_REGION_ID=us

# ---------------------------------------------------------------------
# Universe: US-listed generic/injectable makers + XLV hedge
# ---------------------------------------------------------------------
WEBULL_SYMBOLS=AMPH,TEVA,VTRS,AMRX,BAX,ICUI,XLV
WEBULL_CATEGORY=US_STOCK
WEBULL_TIMESPAN=D
# 2014-2024 needs ~2,700 daily bars; set higher than that.
WEBULL_COUNT=5000

# ---------------------------------------------------------------------
# Dates: IN-SAMPLE ONLY. main.py refuses dates on/after WEBULL_OOS_START
# unless WEBULL_ALLOW_OOS=true (final run only, after git tag freeze-oos).
# ---------------------------------------------------------------------
WEBULL_FROMDATE=2014-01-02T09:30:00-05:00
WEBULL_TODATE=2024-09-30T16:00:00-04:00
WEBULL_OOS_START=2024-10-01T00:00:00-04:00
WEBULL_ALLOW_OOS=false

# ---------------------------------------------------------------------
# Strategy: a file name in examples/strategies/, without .py
# ---------------------------------------------------------------------
WEBULL_STRATEGY=shortage_events
WEBULL_STRATEGY_PARAMS=hold_days=40
SHORTAGE_EVENTS_FILE=data/events.csv

# Costs: 15 bp per side (0.0030 = costs-doubled test)
WEBULL_COMMISSION=0.0015

# Name for this run (results/<label>/ and variants_log.csv). Empty = auto.
WEBULL_RUN_LABEL=main_hold40

# ---------------------------------------------------------------------
# Report and logging
# ---------------------------------------------------------------------
WEBULL_VISUALIZE=true
WEBULL_VISUALIZE_ENGINE=lwc
WEBULL_DISPLAY_TZ=America/New_York
LOG_LEVEL=INFO

# =====================================================================
# TEST VARIANTS: change only these lines, give each run its own label
#
# Connection test:  WEBULL_STRATEGY=dual_ma
#                   WEBULL_STRATEGY_PARAMS=
#                   WEBULL_RUN_LABEL=connection_test
# Random events:    SHORTAGE_EVENTS_FILE=data/events_random.csv
#                   WEBULL_RUN_LABEL=random_events
# Hold 20 days:     WEBULL_STRATEGY_PARAMS=hold_days=20
#                   WEBULL_RUN_LABEL=hold20
# Hold 60 days:     WEBULL_STRATEGY_PARAMS=hold_days=60
#                   WEBULL_RUN_LABEL=hold60
# Costs doubled:    WEBULL_COMMISSION=0.0030
#                   WEBULL_RUN_LABEL=costs_x2
# Drop AMPH:        WEBULL_SYMBOLS=TEVA,VTRS,AMRX,BAX,ICUI,XLV
#                   WEBULL_RUN_LABEL=drop_amph
# Placebo:          SHORTAGE_EVENTS_FILE=data/events_placebo.csv
#                   WEBULL_SYMBOLS=PFE,MRK,XLV
#                   WEBULL_RUN_LABEL=placebo
#
# FINAL OUT-OF-SAMPLE (ONCE, after git tag freeze-oos):
#   WEBULL_ALLOW_OOS=true
#   WEBULL_FROMDATE=2024-10-01T09:30:00-04:00
#   WEBULL_TODATE=<today>T16:00:00-04:00
#   WEBULL_RUN_LABEL=OOS_final
# =====================================================================