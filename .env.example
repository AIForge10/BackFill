# Copy to .env (gitignored) and fill in. Never commit real keys.
# Price data: Webull OpenAPI for US listings (yfinance is used for the rest and as a fallback).
# Without keys, run: python data/download.py prices --vendor yfinance
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us

# Gemini trade summaries (scripts/explain_trades.py only; the dashboard never calls Gemini)
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=

# Snowflake research audit (scripts/load_snowflake.py; install with: uv sync --extra snowflake)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
