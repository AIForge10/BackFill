# Keep secrets in an ignored .env at the REPOSITORY ROOT, not in the browser.
# A read-only database role is recommended. TLS is required by default.
TIGER_DATABASE_URL=postgresql://READ_ONLY_USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
# Optional: a separate writer for explicit ingestion only.
TIGER_INGEST_DATABASE_URL=postgresql://INGEST_USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
