# The ONE environment file for this project. Copy to .env at the repository root (gitignored)
# and fill in only what you use. Never commit real keys.
#
# On a public server, keep only the read-only values the dashboard needs:
#   TIGER_DATABASE_URL, SNOWFLAKE_* (a read-only user/role) and WEBULL_*.
# Writer credentials (TIGER_INGEST_DATABASE_URL, Snowflake admin) and GEMINI_API_KEY are for
# the operator's machine only. scripts/deploy_vultr.sh refuses to upload them.

# --- Webull OpenAPI: US daily prices (research pipeline + dashboard specialist chart) ---
# Without keys, research prices can come from Yahoo: python data/download.py prices --vendor yfinance
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_API_ENDPOINT=api.webull.com
WEBULL_REGION_ID=us

# --- Tiger Data (TimescaleDB): live quotes, archived FDA notices, FDA Time Machine ---
# Reader for the dashboard (use a SELECT-only role). TLS is required by default.
TIGER_DATABASE_URL=postgresql://READ_ONLY_USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
# Writer for ingest / apply_schema / load_tiger only (operator machine, never the public server).
TIGER_INGEST_DATABASE_URL=postgresql://INGEST_USER:PASSWORD@HOST:PORT/tsdb?sslmode=require

# --- Snowflake: research audit (scripts/load_snowflake.py; uv sync --extra snowflake) ---
# Loading needs a role that can create tables; the dashboard should use a read-only user/role.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=BACKFILL
SNOWFLAKE_SCHEMA=RESEARCH

# --- Gemini: precomputed trade summaries (scripts/explain_trades.py only) ---
# The dashboard never calls Gemini; it serves results/explanations.json.
GEMINI_API_KEY=
# Cached summaries were generated with gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite
